#!/bin/sh
# Prepares this machine to run the current version of the repository.
# Works on Linux (Ubuntu, other distributions, cloud) and macOS. Safe to run repeatedly.
set -eu

cd "$(dirname "$0")/.."

step() { printf '\n==> %s\n' "$1"; }
warn() { printf '    warning: %s\n' "$1"; }

step "System: $(uname -s) $(uname -m)"

step "uv (libraries and environments)"
if ! command -v uv >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
    # The installer puts uv in ~/.local/bin or $XDG_BIN_HOME; add it to this session.
    PATH="${XDG_BIN_HOME:-$HOME/.local/bin}:$HOME/.cargo/bin:$PATH"
    export PATH
fi
uv --version

step "Libraries (from uv.lock)"
uv sync --all-packages --group dev --group notebooks --extra pinn

step "Pre-commit hooks"
if [ -d .git ]; then
    uv run pre-commit install
else
    warn "not a git repository; skipping hooks"
fi

step "Git identity"
# Cloud sessions commit as the person who runs them, never as the AI. Set GIT_USER_NAME and GIT_USER_EMAIL
# in the cloud environment (each teammate uses their own).
if [ -n "${GIT_USER_NAME:-}" ] && [ -n "${GIT_USER_EMAIL:-}" ]; then
    git config user.name "$GIT_USER_NAME"
    git config user.email "$GIT_USER_EMAIL"
fi
echo "    $(git config user.name 2>/dev/null || echo unset) <$(git config user.email 2>/dev/null || echo unset)>"

step "Data (DVC)"
# In cloud sessions the DagsHub token comes from the environment (DAGSHUB_USER, DAGSHUB_TOKEN).
if [ ! -f .dvc/config.local ] && [ -n "${DAGSHUB_TOKEN:-}" ]; then
    uv run dvc remote modify origin --local auth basic
    uv run dvc remote modify origin --local user "${DAGSHUB_USER:-Mvzqz}"
    uv run dvc remote modify origin --local password "$DAGSHUB_TOKEN"
fi
if [ -f .dvc/config.local ]; then
    uv run dvc pull || warn "dvc pull failed; check your credentials (docs/installation.md)"
else
    warn "no DagsHub credentials: data not downloaded (docs/installation.md)"
fi

step "NASA Earthdata credentials (only needed to re-download TEMPO from the source)"
if [ -f "$HOME/.netrc" ] && grep -q urs.earthdata.nasa.gov "$HOME/.netrc"; then
    echo "    ok"
else
    warn "no urs.earthdata.nasa.gov entry in ~/.netrc (not needed if you use dvc pull)"
fi

step "Quick check"
uv run nox-ml version
uv run pytest -q

printf '\nDone.\n'
